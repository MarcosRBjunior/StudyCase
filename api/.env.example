# Porta local da API (só para src/server.ts)
PORT=3000
NODE_ENV=development

# Cliente da aplicação (driver adapter). No Supabase: pooler em modo transação, porta 6543,
# com pgbouncer=true e sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/study_case

# Prisma CLI (prisma.config.ts). No Supabase: pooler em modo sessão, porta 5432.
# Nunca use a conexão direta do Supabase (só IPv6).
DIRECT_URL=postgresql://postgres:postgres@localhost:5437/study_case
